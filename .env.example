# docker-compose용 시크릿 - 이 파일을 .env로 복사해서 실제 값을 채울 것.
# .env는 application.yml과 동일하게 .gitignore 대상 (절대 커밋하지 말 것).

# db 컨테이너 MySQL root 비밀번호 - DB 관리용. 앱은 이 계정으로 접속하지 않는다.
MYSQL_ROOT_PASSWORD=change-me

# 앱 전용 DB 계정(webschool)의 비밀번호 - app 컨테이너의 SPRING_DATASOURCE_PASSWORD로 쓰인다.
# webschool DB에만 권한이 있다. root 비밀번호와 다른 값으로 둘 것.
MYSQL_APP_PASSWORD=change-me-too

# (선택) 로컬 Grafana 관리자(admin) 비밀번호 - 비워두면 admin. 최초 기동 때만 적용된다.
GRAFANA_ADMIN_PASSWORD=

# NEIS Open API 키 - application.yml.example의 neis.api.key와 동일한 값
NEIS_API_KEY=YOUR_NEIS_API_KEY

# JWT 로그인 토큰 서명용 HMAC 키 - application.yml.example의 jwt.secret과 동일한 값(32바이트 이상 권장)
JWT_SECRET=change-me-to-a-random-32-byte-string
