# docker-compose용 시크릿 - 이 파일을 .env로 복사해서 실제 값을 채울 것.
# .env는 application.yml과 동일하게 .gitignore 대상 (절대 커밋하지 말 것).

# db 컨테이너 MySQL root 비밀번호. app 컨테이너의 SPRING_DATASOURCE_PASSWORD로도 그대로 재사용됨.
MYSQL_ROOT_PASSWORD=change-me

# NEIS Open API 키 - application.yml.example의 neis.api.key와 동일한 값
NEIS_API_KEY=YOUR_NEIS_API_KEY
