spring:
  application:
    name: webschool
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/webschool?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: root
    password: 'YOUR_DB_PASSWORD'
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true
    database-platform: org.hibernate.dialect.MySQLDialect
  servlet:
    multipart:
      # 리치 에디터(게시글/한마디 본문 삽입)의 동영상 업로드 한도(300MB, FileUploadService 기준)를
      # 감당하려면 이 두 값이 그보다 커야 한다.
      max-file-size: 300MB
      max-request-size: 320MB
  # 구글 소셜 로그인은 선택 사항 - 이 블록을 통째로 비워두면 앱은 정상 기동하고
  # "구글로 로그인" 버튼만 자동으로 숨겨진다(SecurityConfig 참고). 실사용하려면
  # todo.md "0. 소셜 로그인(구글)" 섹션의 발급 절차를 따라 client-id/secret을 채울 것.
  # security:
  #   oauth2:
  #     client:
  #       registration:
  #         google:
  #           client-id: YOUR_GOOGLE_CLIENT_ID
  #           client-secret: YOUR_GOOGLE_CLIENT_SECRET
  #           scope: email, profile
  # 이메일 인증/비밀번호 찾기용 SMTP - 마찬가지로 비워두면 그 기능만 꺼진다.
  # mail:
  #   host: smtp.gmail.com
  #   port: 587
  #   username: YOUR_GMAIL_ADDRESS
  #   password: YOUR_GMAIL_APP_PASSWORD
  #   properties:
  #     mail:
  #       smtp:
  #         auth: true
  #         starttls:
  #           enable: true

server:
  # nginx 리버스 프록시 뒤(운영 서버)에서 X-Forwarded-* 헤더를 신뢰해 HTTPS 리디렉션 URI를
  # 올바르게 만들도록 함 - 로컬 개발(프록시 없음)에서는 아무 영향 없음, 안 넣으면 구글 로그인
  # redirect_uri가 http://로 만들어져서 Google Console에 등록한 https:// URI와 안 맞아 실패한다.
  forward-headers-strategy: framework
  port: 8888

logging:
  file:
    name: logs/webschool.log
  logback:
    rollingpolicy:
      max-history: 30
      max-file-size: 20MB
  level:
    root: INFO
    com.webschool: INFO

management:
  endpoints:
    web:
      exposure:
        include: health,info

neis:
  api:
    key: YOUR_NEIS_API_KEY

app:
  upload:
    dir: ../uploads # 프로젝트 폴더(webproject-main/webproject-main) 밖, 게시글 이미지 저장 위치
    s3:
      bucket: '' # 비어있으면 위 로컬 디스크를 그대로 씀(로컬 개발 기본값). 운영 서버만 실제 버킷명 채움
      region: ap-northeast-2
      base-url: '' # 비워두면 기본 S3 버추얼호스팅 URL(https://{bucket}.s3.{region}.amazonaws.com) 사용
  base-url: http://localhost:8888 # 이메일 인증/비밀번호 재설정 링크에 붙는 주소 - 배포 후 실제 도메인으로 교체
